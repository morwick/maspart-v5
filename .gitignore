.streamlit/secrets.toml

# Artefak runtime (jangan di-commit)
.cache/
__pycache__/
*.pyc
*.pyo

# Cache gambar SIMS (regeneratable, besar)
images/sims_cache/

# Galeri embedding Cari-by-Foto (export tabel part_image_index, besar ~300MB)
part_image_index_rows.csv
data/part_image_index_rows.csv

# Embedding lama Streamlit (tidak dipakai backend FastAPI, besar ~80MB)
data/embeddings.parquet

# Manual PDF sumber kode kesalahan (sudah diekstrak ke fault_codes.json, ~11MB)
data/manuals/
*MC_BOSCHECU*.pdf

# Gambar hasil ekstrak manual (PNG, ~38MB) — aset scp-only (pola data/wiring);
# hanya index.json yang di-track git (metadata pencarian).
data/manual_media/*.png

# Token sesi EPC Sinotruk (kredensial, kedaluwarsa berkala — JANGAN di-commit)
data/epc_token.txt

# Token & kredensial EPC Shantui (rahasia — JANGAN di-commit)
data/shantui_token.txt
data/shantui_cred.json
data/shantui_captcha.png

# Kredensial + checkpoint scraper stok Weichai (rahasia — JANGAN di-commit)
data/weichai_stock_cred.json
data/weichai_stock.json.part

# Output rekonsiliasi katalog↔EPC (laporan, regeneratable)
reconcile_*.csv

# Backend
backend/.env
backend/.cache/
backend/venv/
backend/.venv/

# Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/.env.local

# Binari aplikasi Android (besar ~18MB, di-deploy via scp bukan git)
*.apk

# IDE / OS / build artefak
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Hasil run eval AI (regeneratable)
backend/evals/last_run.json

# Accurate capture (berisi cookie/kredensial) — JANGAN commit
*.har
_accurate_capture.har
account.accurate.id.har
_accurate_curl.txt
_dsi.txt
_accurate_stok_sample.csv
backend/_accurate_*
backend/_dsi.txt
data/accurate_session.json
login accurate.txt
/login accurate.txt
backend/_accurate_cookies.txt
data/epc_unit_items/

# Checkpoint panen tabel penggantian Weichai (build_weichai_replace.py) — file
# kerja yang bisa berukuran puluhan MB & separuh jalan. Hasil JADI-nya
# (data/weichai_replace.json.gz) memang ikut, checkpoint-nya TIDAK.
data/weichai_replace.json.part

# Checkpoint panen klaim garansi (build_warranty_dataset.py) — sama polanya:
# hasil jadi (data/warranty/warranty_klaim.json.gz) ikut, checkpoint-nya TIDAK.
data/warranty/_checkpoint_wo.json

# Bobot model DINOv2 (torch hub) — 335 MB, cache MESIN yang diunduh sendiri saat
# warmup. Tak pernah masuk git: sekali ter-commit ia menetap di RIWAYAT selamanya.
data/torch/

# PDF sumber fault code (34 MB) — BAHAN builder, bukan keluarannya. Pola sama
# dengan data/manuals & data/manual_media: aset scp-only, yang di-track hanya
# hasil jadinya (dataset JSON kode kesalahan).
data/Fault/

# Gambar wiring — aset scp-only (lihat komentar data/manual_media di atas);
# hanya index/metadata yang di-track git.
data/wiring/*.jpg

# Excel hasil kerja di ROOT repo (mis. Part_Kolong_<frame>.xlsx) — keluaran
# sekali pakai untuk dibaca manusia, bukan kode. Sengaja DI-ANCHOR ke root:
# katalog data/Shantui/*.xlsx memang di-track dan tak boleh ikut tersaring.
/*.xlsx
